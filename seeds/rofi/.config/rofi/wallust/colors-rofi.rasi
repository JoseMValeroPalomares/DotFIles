alternate-normal-foreground: #E6CED3;
alternate-urgent-background: #171718;
alternate-urgent-foreground: #E6CED3;

selected-active-background: #52576C;
selected-active-foreground: #171718;
selected-normal-background: #52576C;
selected-normal-foreground: #171718;
selected-urgent-background: #664450;
selected-urgent-foreground: #171718;

background-color: #171718;
background: rgba(0,0,0,0.7);
foreground: #E6CED3;
border-color: #52576C;

color0: #3E3E40;
