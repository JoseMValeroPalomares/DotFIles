 /* wallust template - colors-rofi */

* {
active-background: #52576C;
active-foreground: #E6CED3;
normal-background: #171718;
normal-foreground: #E6CED3;
urgent-background: #AD6D7B;
urgent-foreground: #E6CED3;

alternate-active-background: #664450;
alternate-active-foreground: #E6CED3;
