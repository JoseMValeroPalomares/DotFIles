+void CCanvasMode::leaveAll() {
+    // [exp] Copy the ids first: leave() erases from m_canvasWorkspaces
+    const std::vector<WORKSPACEID> ids(m_canvasWorkspaces.begin(), m_canvasWorkspaces.end());
+    for (const auto id : ids) {
+        if (const auto ws = State::workspaceState()->query().id(id).run())
+            leave(ws);
+        else
+            m_canvasWorkspaces.erase(id); // workspace gone (empty and destroyed): nothing to re-tile
+    }
+}
+
+void CCanvasMode::adoptTiled(const PHLWORKSPACE& ws) {
+    // [exp] Windows moved onto a canvas workspace arrive tiled: float them in place and record
+    // them like enter() does, so leave()/unload re-tile them.
+    if (!isCanvas(ws))
+        return;
+    std::vector<PHLWINDOW> tiled;
+    for (const auto& w : Desktop::windowState()->windows())
+        if (onWorkspace(w, ws) && !w->m_isFloating && !Fullscreen::controller()->isFullscreen(w))
+            tiled.push_back(w);
+
+    // Snapshot first (floating one re-tiles the rest), then float — same two passes as enter()
+    std::vector<std::pair<PHLWINDOW, CBox>> boxes;
+    for (const auto& w : tiled) {
+        boxes.emplace_back(w, CBox{w->positionAnimation()->goal(), w->sizeAnimation()->goal()});
+        m_saved[ws->m_id].push_back({w, false, w->positionAnimation()->goal(), w->sizeAnimation()->goal()});
+    }
+    for (const auto& [w, box] : boxes) {
+        const auto t = w->layoutTarget();
+        if (!t)
+            continue;
+        g_layoutManager->changeFloatingMode(t);
+        g_layoutManager->setTargetGeom(box, t);
+    }
+}
