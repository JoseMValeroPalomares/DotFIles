+// [exp] The monitor under the cursor shows a canvas workspace. Grab-pan and the minimap gate on
+// this instead of anyActive(), so with one canvas workspace the others keep middle-click/Ctrl-click.
+static bool cursorOnCanvas() {
+    const auto mon = State::monitorState()->query().vec(g_pInputManager->getMouseCoordsInternal()).run();
+    return mon && g_canvas && g_canvas->isCanvas(mon->m_activeWorkspace);
+}
+
+// [exp] Lua API: hl.plugin.hyprplane.<fn>. Never raise Lua errors here (longjmp would skip C++
+// destructors): read args with the non-throwing lua_to*x and ignore bad input.
+static PHLWORKSPACE luaWorkspaceArg(lua_State* L) {
+    int        isnum = 0;
+    const auto id    = lua_tointegerx(L, 1, &isnum);
+    return isnum ? State::workspaceState()->query().id((WORKSPACEID)id).run() : nullptr;
+}
+
+static int luaEnter(lua_State* L) {
+    if (const auto ws = luaWorkspaceArg(L)) {
+        g_canvas->enter(ws);
+        syncCanvasMarker();
+    }
+    return 0;
+}
+
+static int luaLeave(lua_State* L) {
+    if (const auto ws = luaWorkspaceArg(L)) {
+        g_canvas->leave(ws);
+        syncCanvasMarker();
+    }
+    return 0;
+}
+
+static int luaToggle(lua_State* L) {
+    const auto ws = luaWorkspaceArg(L);
+    if (!ws)
+        return 0;
+    g_canvas->toggle(ws);
+    syncCanvasMarker();
+    HyprlandAPI::addNotification(PHANDLE, g_canvas->isCanvas(ws) ? "[hyprplane] ON" : "[hyprplane] OFF",
+                                  CHyprColor{0.2F, 0.8F, 1.0F, 1.0F}, 1500);
+    return 0;
+}
+
+static int luaIsCanvas(lua_State* L) {
+    const auto ws = luaWorkspaceArg(L);
+    lua_pushboolean(L, ws && g_canvas->isCanvas(ws));
+    return 1;
+}
+
+static int luaPan(lua_State* L) {
+    int        okx = 0, oky = 0;
+    const auto dx = lua_tonumberx(L, 1, &okx), dy = lua_tonumberx(L, 2, &oky);
+    if (okx && oky && g_canvas->anyActive())
+        g_canvas->panAllActive(Vector2D{dx, dy});
+    return 0;
+}
+
+static int luaJump(lua_State* L) {
+    int        isnum = 0;
+    const auto n     = lua_tointegerx(L, 1, &isnum);
+    if (isnum && g_canvas->anyActive())
+        g_canvas->jumpToWindow((int)n);
+    return 0;
+}
+
+static int luaAdopt(lua_State* L) {
+    if (const auto ws = luaWorkspaceArg(L))
+        g_canvas->adoptTiled(ws);
+    return 0;
+}
+
+static int luaGather(lua_State* L) {
+    if (g_canvas->anyActive())
+        g_canvas->gather();
+    return 0;
+}
