{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": true,
  "cssPriority": "user",
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 10,
  "control-center-margin-left": 10,
  "control-center-width": 420,
  "control-center-exclusive-zone": true,
  "fit-to-screen": true,
  "notification-window-width": 365,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-body-image-height": 120,
  "notification-body-image-width": 320,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "relative-timestamps": true,
  "notification-grouping": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 180,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "Sin notificaciones",
  "script-fail-notify": true,
  "scripts": {
    "zen-foco": {
      "exec": "$HOME/.config/swaync/scripts/focus-zen.sh",
      "desktop-entry": "^zen$",
      "run-on": "action"
    }
  },
  "notification-visibility": {
    "spotify": {
      "state": "transient",
      "app-name": "[Ss]potify"
    },
    "zen": {
      "state": "enabled",
      "desktop-entry": "^zen$",
      "override-urgency": "normal"
    }
  },
  "widgets": [
    "title",
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notificaciones",
      "clear-all-button": true,
      "button-text": "Borrar todo"
    },
    "dnd": {
      "text": "No molestar"
    },
    "mpris": {
      "show-album-art": "when-available",
      "autohide": true,
      "blacklist": [
        "playerctld"
      ]
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true,
      "show-per-app-label": true,
      "expand-button-label": "󰅀",
      "collapse-button-label": "󰅃",
      "empty-list-label": "Ninguna app reproduce audio"
    },
    "backlight": {
      "label": "󰃟",
      "device": "intel_backlight"
    },
    "buttons-grid": {
      "buttons-per-row": 6,
      "actions": [
        {
          "label": "󰤨",
          "type": "toggle",
          "active": true,
          "command": "$HOME/.config/swaync/scripts/toggle.sh wifi set",
          "update-command": "$HOME/.config/swaync/scripts/toggle.sh wifi get"
        },
        {
          "label": "󰂯",
          "type": "toggle",
          "active": false,
          "command": "$HOME/.config/swaync/scripts/toggle.sh bt set",
          "update-command": "$HOME/.config/swaync/scripts/toggle.sh bt get"
        },
        {
          "label": "󰝟",
          "type": "toggle",
          "active": false,
          "command": "$HOME/.config/swaync/scripts/toggle.sh mute set",
          "update-command": "$HOME/.config/swaync/scripts/toggle.sh mute get"
        },
        {
          "label": "󰍭",
          "type": "toggle",
          "active": false,
          "command": "$HOME/.config/swaync/scripts/toggle.sh mic set",
          "update-command": "$HOME/.config/swaync/scripts/toggle.sh mic get"
        },
        {
          "label": "󰌾",
          "command": "$HOME/.config/swaync/scripts/run-closed.sh $HOME/.config/hypr/scripts/LockScreen.sh"
        },
        {
          "label": "󰐥",
          "command": "$HOME/.config/swaync/scripts/run-closed.sh $HOME/.config/hypr/scripts/Wlogout.sh"
        }
      ]
    },
    "notifications": {
      "vexpand": true
    }
  }
}
