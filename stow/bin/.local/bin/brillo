#!/usr/bin/env bash
# brillo — brillo del portátil (brightnessctl) y del monitor externo (ddcutil, DDC/CI)
# No necesita sudo: la regla udev de ddcutil (60-ddcutil-i2c.rules) da acceso al bus I²C del monitor.

usage() {
    cat <<'EOF'
Uso: brillo                 muestra el brillo actual
     brillo N               ambas pantallas al N %   (0-100)
     brillo +N | -N         sube o baja ambas N puntos
     brillo int N|+N|-N     solo la pantalla del portátil
     brillo ext N|+N|-N     solo el monitor externo
EOF
}

# "N", "+N" o "-N", con N entre 0 y 100
valid() { [[ "$1" =~ ^[+-]?[0-9]{1,3}$ ]] && (( 10#${1#[+-]} <= 100 )); }

# brightnessctl -m: "intel_backlight,backlight,35520,37%,96000"
get_int() { local p; IFS=, read -r _ _ _ p _ < <(brightnessctl -m) && echo "${p%\%}"; }

# ddcutil --brief: "VCP 10 C <actual> <máximo>"
get_ext() { local v; read -r _ _ _ v _ < <(ddcutil getvcp 10 --brief 2>/dev/null) && [[ -n "$v" ]] && echo "$v"; }

set_int() {
    local v="$1" p
    case "$v" in
        +*) v="${v#+}%+" ;;
        -*) v="${v#-}%-" ;;
        *)  v="$v%" ;;
    esac
    if ! IFS=, read -r _ _ _ p _ < <(brightnessctl -m set "$v"); then
        echo "Interna: no se pudo cambiar el brillo" >&2
        return 1
    fi
    echo "Interna: ${p%\%} %"
}

set_ext() {
    local v="$1" cur
    if [[ "$v" == [+-]* ]]; then
        if ! cur=$(get_ext); then
            echo "Externa: no detectada (¿conectada y con DDC/CI activado en su menú?)" >&2
            return 1
        fi
        v=$(( cur + v ))
        (( v < 0 )) && v=0
        (( v > 100 )) && v=100
    fi
    if ! ddcutil setvcp 10 "$((10#$v))" >/dev/null 2>&1; then
        echo "Externa: no detectada (¿conectada y con DDC/CI activado en su menú?)" >&2
        return 1
    fi
    echo "Externa: $((10#$v)) %"
}

case "${1:-}" in
    "")
        echo "Interna: $(get_int) %"
        if ext=$(get_ext); then echo "Externa: $ext %"; else echo "Externa: no detectada"; fi
        ;;
    -h | --help)
        usage
        ;;
    int | ext)
        if ! valid "${2:-}"; then usage >&2; exit 1; fi
        "set_$1" "$2"
        ;;
    *)
        if ! valid "$1"; then usage >&2; exit 1; fi
        status=0
        set_int "$1" || status=1
        set_ext "$1" || status=1
        exit "$status"
        ;;
esac
