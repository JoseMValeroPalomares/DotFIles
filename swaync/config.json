{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "center",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 10,
  "control-center-margin-left": 10,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-icon-size": 48,
  "notification-body-image-height": 80,
  "notification-body-image-width": 80,
  "notification-window-width": 280,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "control-center-width": 450,
  "control-center-height": 850,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
      "title",
      "buttons-grid",
      "mpris",
      "volume", 
      "backlight",
      "dnd",
      "notifications"
  ],
  "widget-config": {
      "title": {
          "text": " Notificaciones",
          "clear-all-button": true,
          "button-text": "󰎟 Borrar"
      },
      "dnd": {
          "text": "No Molestar"
      },
      "mpris": {
          "image-size": 60,
          "image-radius": 10
      },
      "volume": {
          "label": "󰕾"
      },
      "backlight": {
          "label": "󰃟"
      },
      "buttons-grid": {
          "actions": [
              { "label": "󰌾", "command": "bash -c $HOME/.config/hypr/scripts/LockScreen.sh" },
              { "label": "󰝟", "command": "pactl set-sink-mute @DEFAULT_SINK@ toggle" },
              { "label": "󰂯", "command": "blueman-manager" },
              { "label": "󰐥", "command": "bash -c $HOME/.config/hypr/scripts/Wlogout.sh" }
          ]
      }
  }
}